# Copy this file to .env.local and fill in the 3 values from Supabase
# (Supabase dashboard > Project Settings > API Keys). Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# The "anon" key (older dashboards) or "publishable" key (newer dashboards)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key (older) or "secret" key (newer). Used ONLY by the seed script. Keep private.
SUPABASE_SERVICE_ROLE_KEY=
