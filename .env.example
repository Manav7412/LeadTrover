# Copy this file to .env.local and fill in the 3 values from Supabase
# (Supabase dashboard > Project Settings > API Keys). Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# The "anon" key (older dashboards) or "publishable" key (newer dashboards)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key (older) or "secret" key (newer). Used ONLY by the seed script. Keep private.
SUPABASE_SERVICE_ROLE_KEY=

# Trovie, the AI assistant (optional). Get a key at console.anthropic.com > API keys. Server-side only: never put NEXT_PUBLIC_ in front of it.
ANTHROPIC_API_KEY=
# Optional: which Claude model Trovie uses (default claude-opus-5-5; claude-sonnet-5-5 or claude-haiku-5-5 are cheaper)
# TROVIE_MODEL=claude-opus-5-5
# Optional: questions per person per day (the shared Guest login defaults to 25, everyone else to 60)
# TROVIE_GUEST_DAILY_LIMIT=25
# TROVIE_USER_DAILY_LIMIT=60
